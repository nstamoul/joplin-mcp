# Joplin MCP Server Configuration

# MCP Server Settings
# Transport protocol (streamable-http recommended for Docker/HTTP deployments)
MCP_TRANSPORT=streamable-http

# Host to bind to (0.0.0.0 to listen on all interfaces)
MCP_HOST=0.0.0.0

# Port to listen on (default: 8000)
MCP_PORT=8000

# Base path for the MCP server (default: /mcp)
MCP_PATH=/mcp

# Log level (debug, info, warning, error)
MCP_LOG_LEVEL=info

# Joplin Connection Settings
# Your Joplin API token (required)
# Get this from Joplin: Tools > Options > Web Clipper > Advanced options
JOPLIN_API_TOKEN=your_joplin_api_token_here

# Joplin base URL (default: http://localhost:41184)
# For Docker deployments, this might be host.docker.internal:41184
JOPLIN_BASE_URL=http://localhost:41184

# Optional: Path to Joplin MCP configuration file
# JOPLIN_MCP_CONFIG=/config/joplin-mcp.json
